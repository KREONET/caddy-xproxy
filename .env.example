# Copy to .env and fill in. Never commit .env.
# .env 로 복사해서 채운다. .env 는 커밋하지 않는다.
# refer to docs/install.md
ACME_EMAIL=admin@example.com

# DNS-01 only. The server value includes the port.
# DNS-01 을 쓸 때만. 서버 값에는 포트까지 넣는다.
# refer to docs/tls.md
DNS_TSIG_KEYNAME=
DNS_TSIG_ALG=hmac-sha256
DNS_TSIG_SECRET=
DNS_TSIG_SERVER=

# OIDC gate only. cookie_secret must be 32 bytes.
# OIDC 게이트를 쓸 때만. cookie_secret 은 32바이트여야 한다.
# refer to docs/oidc.md
O2P_CLIENT_SECRET=
O2P_COOKIE_SECRET=
